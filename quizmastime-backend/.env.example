# Environment Variables for QuizmasTime Backend

# Server Configuration
PORT=8080

# Database Configuration (Local Development)
MYSQL_URL=jdbc:mysql://localhost:3306/quizmastime
MYSQL_USER=quizmastime
MYSQL_PASSWORD=your_password_here

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# CORS Configuration
# For local development with Angular CLI
CORS_ALLOWED_ORIGINS=http://localhost:4200
# For production, use your deployed frontend URL:
# CORS_ALLOWED_ORIGINS=https://your-app.netlify.app
# Multiple origins (comma-separated):
# CORS_ALLOWED_ORIGINS=https://app1.netlify.app,https://app2.netlify.app

# Quiz Configuration
QUIZ_LOCKOUT_DURATION=30
